<!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="theme-color" content="#f5f7f4">
	<title>EchoCash | Payments, made clear</title>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
	<style>
		:root {
			color-scheme: light;
			--ink: #17221e;
			--muted: #738079;
			--line: #e4eae6;
			--paper: #ffffff;
			--canvas: #f5f7f4;
			--green: #177a58;
			--green-dark: #105c42;
			--green-soft: #e6f4ec;
			--coral: #e66b52;
			--coral-soft: #fff0eb;
			--shadow: 0 16px 45px rgba(24, 48, 37, .08);
			font-family: 'DM Sans', sans-serif;
			font-synthesis: none;
			text-rendering: optimizeLegibility;
		}

		* { box-sizing: border-box; }
		body { margin: 0; min-width: 320px; min-height: 100vh; color: var(--ink); background: var(--canvas); }
		button, input, select { font: inherit; }
		button { cursor: pointer; }
		a { color: inherit; text-decoration: none; }
		.layout { min-height: 100vh; }
		.sidebar {
			position: fixed; inset: 0 auto 0 0; z-index: 5; display: flex; width: 238px; flex-direction: column;
			padding: 25px 16px 18px; background: #fff; border-right: 1px solid var(--line);
		}
		.brand { display: flex; align-items: center; gap: 10px; padding: 0 10px 34px; font: 700 20px 'Space Grotesk', sans-serif; letter-spacing: 0; }
		.brand-mark { display: grid; width: 34px; height: 34px; place-items: center; border-radius: 10px; background: var(--green); color: #fff; }
		.brand-mark svg { width: 19px; height: 19px; }
		.workspace-label { padding: 0 11px 10px; color: #a0aaa4; font-size: 10px; font-weight: 700; letter-spacing: 1.1px; text-transform: uppercase; }
		.nav { display: grid; gap: 5px; }
		.nav-link { display: flex; align-items: center; gap: 12px; min-height: 43px; padding: 0 11px; border-radius: 7px; color: #68756e; font-size: 13px; font-weight: 600; transition: background .18s, color .18s; }
		.nav-link:hover { background: #f4f7f4; color: var(--ink); }
		.nav-link.active { background: var(--green-soft); color: var(--green-dark); }
		.nav-link svg { width: 17px; height: 17px; flex: none; }
		.nav-count { margin-left: auto; padding: 2px 7px; border-radius: 10px; background: #edf0ed; color: #6f7b73; font-size: 10px; }
		.sidebar-bottom { margin-top: auto; }
		.help-link { display: flex; align-items: center; gap: 10px; padding: 12px 11px; color: #68756e; font-size: 12px; }
		.help-link svg { width: 17px; height: 17px; }
		.profile { display: flex; align-items: center; gap: 10px; padding: 13px 8px 0; border-top: 1px solid var(--line); }
		.avatar { display: grid; width: 34px; height: 34px; place-items: center; border-radius: 50%; background: #f8d8ce; color: #9b4938; font-size: 12px; font-weight: 700; }
		.profile-name { font-size: 12px; font-weight: 700; }
		.profile-role { margin-top: 2px; color: var(--muted); font-size: 10px; }
		.main { max-width: 1510px; min-height: 100vh; margin-left: 238px; padding: 0 46px 52px; }
		.topbar { display: flex; height: 72px; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); }
		.crumb { color: var(--muted); font-size: 12px; }
		.crumb strong { color: var(--ink); font-weight: 600; }
		.top-actions { display: flex; align-items: center; gap: 13px; }
		.mode-pill { display: inline-flex; align-items: center; gap: 7px; padding: 7px 10px; border: 1px solid #f2c6b9; border-radius: 5px; background: var(--coral-soft); color: #a84935; font-size: 10px; font-weight: 700; letter-spacing: .2px; }
		.mode-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--coral); }
		.icon-button { display: grid; width: 34px; height: 34px; place-items: center; border: 1px solid var(--line); border-radius: 6px; background: #fff; color: #5e6b63; }
		.icon-button svg { width: 16px; height: 16px; }
		.page-heading { display: flex; align-items: end; justify-content: space-between; gap: 20px; padding: 34px 0 25px; }
		.eyebrow { margin: 0 0 8px; color: var(--green); font-size: 10px; font-weight: 700; letter-spacing: 1.15px; text-transform: uppercase; }
		h1, h2, h3, p { margin-top: 0; }
		h1 { margin-bottom: 6px; font: 600 28px 'Space Grotesk', sans-serif; letter-spacing: 0; }
		.heading-copy { margin-bottom: 0; color: var(--muted); font-size: 13px; }
		.date-label { color: var(--muted); font-size: 11px; }
		.summary-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin-bottom: 22px; }
		.summary-card { min-height: 105px; padding: 17px 18px; border: 1px solid var(--line); border-radius: 7px; background: var(--paper); }
		.summary-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; color: var(--muted); font-size: 11px; }
		.summary-icon { display: grid; width: 28px; height: 28px; place-items: center; border-radius: 6px; background: #eff6f1; color: var(--green); }
		.summary-icon.coral { background: var(--coral-soft); color: var(--coral); }
		.summary-icon svg { width: 15px; height: 15px; }
		.summary-value { margin: 11px 0 0; font: 600 24px 'Space Grotesk', sans-serif; letter-spacing: 0; }
		.summary-note { margin: 3px 0 0; color: #9aa49e; font-size: 10px; }
		.content-grid { display: grid; grid-template-columns: minmax(0, 1.18fr) minmax(285px, .82fr); gap: 17px; align-items: start; }
		.panel { border: 1px solid var(--line); border-radius: 7px; background: var(--paper); }
		.panel-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 19px 20px 15px; }
		.panel-title { margin: 0; font: 600 15px 'Space Grotesk', sans-serif; letter-spacing: 0; }
		.panel-caption { margin: 5px 0 0; color: var(--muted); font-size: 11px; }
		.segmented { display: inline-flex; padding: 3px; border-radius: 6px; background: #f1f4f1; }
		.segment { min-height: 29px; padding: 0 11px; border: 0; border-radius: 4px; background: transparent; color: #738079; font-size: 10px; font-weight: 700; }
		.segment.active { background: #fff; color: var(--green-dark); box-shadow: 0 1px 3px rgba(20, 40, 29, .1); }
		.form-body { padding: 4px 20px 20px; }
		.field { margin-top: 15px; }
		.field:first-child { margin-top: 7px; }
		.field-label { display: flex; justify-content: space-between; gap: 8px; margin-bottom: 7px; color: #47554d; font-size: 11px; font-weight: 700; }
		.optional { color: #98a29c; font-weight: 400; }
		.input-wrap { display: flex; min-height: 43px; align-items: center; border: 1px solid #dce4de; border-radius: 5px; background: #fff; transition: border-color .15s, box-shadow .15s; }
		.input-wrap:focus-within { border-color: #5eaa83; box-shadow: 0 0 0 3px rgba(23, 122, 88, .1); }
		.input-wrap input, .input-wrap select { width: 100%; min-width: 0; height: 41px; padding: 0 11px; border: 0; outline: 0; background: transparent; color: var(--ink); font-size: 12px; }
		.amount-wrap { padding-left: 12px; }
		.currency-symbol { color: #819087; font: 500 14px 'Space Grotesk', sans-serif; }
		.amount-wrap input { height: 46px; font: 600 20px 'Space Grotesk', sans-serif; }
		.amount-wrap select { width: 82px; height: 28px; margin-right: 8px; padding: 0 6px; border-left: 1px solid var(--line); color: #5c6b62; font-size: 11px; }
		.helper { margin: 6px 0 0; color: #9aa49e; font-size: 10px; line-height: 1.5; }
		.primary-button { display: flex; width: 100%; min-height: 43px; align-items: center; justify-content: center; gap: 9px; margin-top: 20px; border: 0; border-radius: 5px; background: var(--green); color: #fff; font-size: 12px; font-weight: 700; transition: background .15s, transform .15s; }
		.primary-button:hover { transform: translateY(-1px); background: var(--green-dark); }
		.primary-button svg { width: 16px; height: 16px; }
		.secure-note { display: flex; align-items: center; justify-content: center; gap: 6px; margin: 11px 0 0; color: #89958d; font-size: 10px; }
		.secure-note svg { width: 13px; height: 13px; color: var(--green); }
		.preview-panel { overflow: hidden; }
		.preview-banner { position: relative; min-height: 133px; overflow: hidden; padding: 20px; background: #eaf4ed; }
		.preview-banner::before, .preview-banner::after { position: absolute; content: ''; border: 1px solid rgba(23, 122, 88, .13); border-radius: 50%; }
		.preview-banner::before { width: 206px; height: 206px; top: -113px; right: -39px; }
		.preview-banner::after { width: 154px; height: 154px; top: -86px; right: -14px; }
		.preview-kicker { position: relative; z-index: 1; margin-bottom: 9px; color: #51816b; font-size: 9px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; }
		.preview-banner h2 { position: relative; z-index: 1; max-width: 225px; margin-bottom: 8px; font: 600 19px 'Space Grotesk', sans-serif; line-height: 1.25; letter-spacing: 0; }
		.preview-banner p { position: relative; z-index: 1; margin: 0; color: #648170; font-size: 10px; }
		.checkout-card { position: relative; z-index: 2; margin: -16px 14px 14px; padding: 15px; border: 1px solid var(--line); border-radius: 6px; background: #fff; box-shadow: 0 8px 18px rgba(30, 63, 43, .06); }
		.checkout-top { display: flex; align-items: center; justify-content: space-between; color: #8a968e; font-size: 9px; }
		.checkout-merchant { display: flex; align-items: center; gap: 7px; color: var(--ink); font-size: 10px; font-weight: 700; }
		.mini-mark { display: grid; width: 21px; height: 21px; place-items: center; border-radius: 6px; background: var(--green); color: white; font: 700 10px 'Space Grotesk', sans-serif; }
		.checkout-amount { margin: 20px 0 4px; font: 600 25px 'Space Grotesk', sans-serif; letter-spacing: 0; }
		.checkout-caption { margin-bottom: 14px; color: #8b978f; font-size: 9px; }
		.checkout-method { display: flex; align-items: center; justify-content: space-between; min-height: 35px; padding: 0 9px; border: 1px solid #dfe7e1; border-radius: 4px; color: #69766e; font-size: 9px; }
		.method-left { display: flex; align-items: center; gap: 7px; }
		.card-chip { width: 18px; height: 12px; border: 1px solid #a8b6ac; border-radius: 2px; }
		.checkout-continue { width: 100%; min-height: 34px; margin-top: 9px; border: 0; border-radius: 4px; background: var(--green); color: white; font-size: 9px; font-weight: 700; }
		.secure-caption { margin: 8px 0 0; text-align: center; color: #a0aaa4; font-size: 8px; }
		.activity-panel { margin-top: 18px; }
		.activity-head { padding-bottom: 13px; }
		.text-button { padding: 5px 0; border: 0; background: transparent; color: var(--green); font-size: 10px; font-weight: 700; }
		.activity-list { border-top: 1px solid var(--line); }
		.empty-state { display: grid; min-height: 115px; place-items: center; padding: 20px; text-align: center; }
		.empty-state-mark { display: grid; width: 31px; height: 31px; margin: 0 auto 8px; place-items: center; border-radius: 50%; background: #f1f5f2; color: #91a097; }
		.empty-state-mark svg { width: 15px; height: 15px; }
		.empty-state p { margin: 0; color: #849188; font-size: 11px; }
		.activity-row { display: grid; grid-template-columns: 32px 1fr auto; gap: 10px; align-items: center; min-height: 58px; padding: 9px 20px; border-bottom: 1px solid #f0f3f0; }
		.activity-row:last-child { border-bottom: 0; }
		.activity-icon { display: grid; width: 29px; height: 29px; place-items: center; border-radius: 6px; background: var(--green-soft); color: var(--green); }
		.activity-icon svg { width: 14px; height: 14px; }
		.activity-description { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 11px; font-weight: 700; }
		.activity-meta { margin-top: 3px; color: #929d95; font-size: 9px; }
		.activity-amount { text-align: right; font: 600 12px 'Space Grotesk', sans-serif; }
		.activity-status { margin-top: 3px; color: var(--green); font-size: 9px; text-align: right; }
		.links-panel { margin-top: 18px; }
		.links-list { border-top: 1px solid var(--line); }
		.link-row { display: grid; grid-template-columns: 1fr auto; gap: 8px; align-items: center; padding: 12px 20px; border-bottom: 1px solid #f0f3f0; }
		.link-title { overflow: hidden; color: var(--ink); font-size: 10px; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
		.link-url { overflow: hidden; margin-top: 3px; color: #89968d; font: 10px 'DM Sans', sans-serif; text-overflow: ellipsis; white-space: nowrap; }
		.copy-link { padding: 7px 9px; border: 1px solid var(--line); border-radius: 4px; background: #fff; color: var(--green-dark); font-size: 9px; font-weight: 700; }
		.demo-footer { margin: 20px 0 0; color: #99a39c; font-size: 9px; line-height: 1.6; }
		.modal-backdrop { position: fixed; inset: 0; z-index: 20; display: grid; place-items: center; padding: 18px; background: rgba(17, 29, 23, .46); animation: fade-in .16s ease-out; }
		.modal-backdrop[hidden] { display: none; }
		.modal { width: min(100%, 410px); padding: 24px; border: 1px solid rgba(255,255,255,.5); border-radius: 8px; background: #fff; box-shadow: var(--shadow); animation: rise-in .2s ease-out; }
		.modal-top { display: flex; align-items: start; justify-content: space-between; gap: 12px; }
		.modal-icon { display: grid; width: 38px; height: 38px; place-items: center; border-radius: 9px; background: var(--green-soft); color: var(--green); }
		.modal-icon svg { width: 20px; height: 20px; }
		.modal-close { display: grid; width: 30px; height: 30px; place-items: center; border: 0; border-radius: 5px; background: #f2f5f2; color: #6e7b72; font-size: 18px; }
		.modal h2 { margin: 18px 0 7px; font: 600 21px 'Space Grotesk', sans-serif; letter-spacing: 0; }
		.modal-copy { margin: 0; color: #738079; font-size: 12px; line-height: 1.6; }
		.order-summary { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 19px 0; padding: 13px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
		.order-merchant { display: flex; align-items: center; gap: 9px; font-size: 11px; font-weight: 700; }
		.order-total { font: 600 17px 'Space Grotesk', sans-serif; }
		.modal-disclaimer { display: flex; gap: 9px; padding: 11px; border-radius: 5px; background: #fff5ed; color: #8a5738; font-size: 10px; line-height: 1.5; }
		.modal-disclaimer svg { width: 15px; height: 15px; flex: none; }
		.modal .primary-button { margin-top: 16px; }
		.modal-secondary { width: 100%; min-height: 37px; margin-top: 7px; border: 0; background: transparent; color: #728078; font-size: 11px; font-weight: 600; }
		.toast { position: fixed; right: 22px; bottom: 20px; z-index: 30; max-width: min(370px, calc(100vw - 32px)); padding: 12px 16px; border-radius: 5px; background: #18392b; color: white; box-shadow: var(--shadow); font-size: 11px; opacity: 0; pointer-events: none; transform: translateY(8px); transition: opacity .2s, transform .2s; }
		.toast.show { opacity: 1; transform: translateY(0); }
		.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
		@keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }
		@keyframes rise-in { from { opacity: 0; transform: translateY(7px); } to { opacity: 1; transform: translateY(0); } }
		@media (max-width: 1080px) {
			.main { padding-right: 28px; padding-left: 28px; }
			.content-grid { grid-template-columns: minmax(0, 1fr) minmax(260px, .8fr); }
		}
		@media (max-width: 820px) {
			.sidebar { position: sticky; inset: 0 0 auto; width: 100%; height: auto; padding: 10px 15px 8px; border-right: 0; border-bottom: 1px solid var(--line); }
			.brand { padding: 0 3px 10px; font-size: 18px; }
			.brand-mark { width: 30px; height: 30px; }
			.workspace-label, .sidebar-bottom { display: none; }
			.nav { display: flex; gap: 4px; overflow-x: auto; scrollbar-width: none; }
			.nav::-webkit-scrollbar { display: none; }
			.nav-link { flex: none; min-height: 36px; padding: 0 9px; font-size: 11px; }
			.nav-link svg { width: 15px; height: 15px; }
			.nav-count { display: none; }
			.main { margin-left: 0; padding: 0 24px 38px; }
			.topbar { height: 58px; }
		}
		@media (max-width: 620px) {
			.main { padding-right: 16px; padding-left: 16px; }
			.topbar { height: 54px; }
			.mode-pill { padding: 6px 8px; font-size: 9px; }
			.page-heading { align-items: start; padding: 27px 0 20px; }
			h1 { font-size: 24px; }
			.heading-copy { max-width: 255px; font-size: 11px; line-height: 1.5; }
			.date-label { display: none; }
			.summary-grid { grid-template-columns: 1fr 1fr; gap: 9px; margin-bottom: 13px; }
			.summary-card { min-height: 94px; padding: 13px; }
			.summary-card:last-child { grid-column: span 2; min-height: 76px; }
			.summary-value { font-size: 21px; }
			.summary-note { font-size: 9px; }
			.content-grid { grid-template-columns: 1fr; gap: 12px; }
			.form-body { padding-right: 15px; padding-left: 15px; }
			.panel-head { padding-right: 15px; padding-left: 15px; }
			.panel-title { font-size: 14px; }
			.segment { padding: 0 9px; font-size: 9px; }
			.preview-panel { grid-row: 1; }
			.preview-banner { min-height: 114px; }
			.preview-banner h2 { max-width: 210px; font-size: 17px; }
			.checkout-card { margin-right: 12px; margin-left: 12px; }
			.activity-panel, .links-panel { margin-top: 12px; }
			.activity-row { padding-right: 14px; padding-left: 14px; }
			.link-row { padding-right: 14px; padding-left: 14px; }
			.toast { right: 16px; bottom: 15px; }
		}
		@media (prefers-reduced-motion: reduce) {
			*, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; transition-duration: .01ms !important; }
		}
	</style>
</head>
<body>
	<div class="layout">
		<aside class="sidebar" aria-label="Main navigation">
			<a class="brand" href="#overview" aria-label="EchoCash overview">
				<span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M4 12h4l2.1-5 3.8 10 2.1-5H20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
				<span>echocash</span>
			</a>
			<div class="workspace-label">Workspace</div>
			<nav class="nav">
				<a class="nav-link active" href="#overview" data-view="overview"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3.5" y="3.5" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.7"/><rect x="13.5" y="3.5" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.7"/><rect x="3.5" y="13.5" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.7"/><rect x="13.5" y="13.5" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.7"/></svg>Overview</a>
				<a class="nav-link" href="#collect" data-view="collect"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>Collect payment</a>
				<a class="nav-link" href="#requests" data-view="requests"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 3.75h7l4.25 4.3V20a.75.75 0 0 1-.75.75H7A1.75 1.75 0 0 1 5.25 19V5.5A1.75 1.75 0 0 1 7 3.75Z" stroke="currentColor" stroke-width="1.6"/><path d="M14 4v4.5h4.5M8.5 13h7M8.5 16.5h5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>Payment requests<span class="nav-count" id="requestCount">0</span></a>
				<a class="nav-link" href="#activity" data-view="activity"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 18V6m5 12V9m5 9V4m5 14v-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>Activity</a>
			</nav>
			<div class="sidebar-bottom">
				<a class="help-link" href="mailto:hello@echocash.example"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.6"/><path d="M9.6 9.3a2.5 2.5 0 1 1 4.1 1.9c-1 .8-1.7 1.1-1.7 2.3m0 3v.1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>Help &amp; support</a>
				<div class="profile"><div class="avatar" aria-hidden="true">EC</div><div><div class="profile-name">EchoCash Studio</div><div class="profile-role">Demo workspace</div></div></div>
			</div>
		</aside>

		<main class="main" id="overview">
			<header class="topbar">
				<div class="crumb">Workspace <span aria-hidden="true">/</span> <strong id="breadcrumb">Overview</strong></div>
				<div class="top-actions"><span class="mode-pill"><span class="mode-dot" aria-hidden="true"></span>DEMO MODE</span><button class="icon-button" type="button" aria-label="Notifications" title="Notifications"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M18 9a6 6 0 0 0-12 0c0 7-2.5 7.5-2.5 9h17C20.5 16.5 18 16 18 9Zm-8 12h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button></div>
			</header>

			<section class="page-heading">
				<div><p class="eyebrow">Your payment workspace</p><h1>Payments, made clear.</h1><p class="heading-copy">Collect a payment or send a request, all from one place.</p></div>
				<p class="date-label" id="todayLabel"></p>
			</section>

			<section class="summary-grid" aria-label="Demo workspace summary">
				<article class="summary-card"><div class="summary-top"><span>Payments received</span><span class="summary-icon"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span></div><p class="summary-value" id="receivedTotal">$0.00</p><p class="summary-note">Demo transactions only</p></article>
				<article class="summary-card"><div class="summary-top"><span>Successful checkouts</span><span class="summary-icon coral"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7.5h16v11H4zM4 10h16M8 15h3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></span></div><p class="summary-value" id="paymentCount">0</p><p class="summary-note">Since this demo started</p></article>
				<article class="summary-card"><div class="summary-top"><span>Open payment requests</span><span class="summary-icon"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 4.5h12v15H6zM9 9h6m-6 3.5h6m-6 3.5h3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></span></div><p class="summary-value" id="openRequestCount">0</p><p class="summary-note">Shareable demo links</p></article>
			</section>

			<div class="content-grid">
				<section class="panel" id="collect" aria-labelledby="collectTitle">
					<div class="panel-head"><div><h2 class="panel-title" id="collectTitle">Collect a payment</h2><p class="panel-caption" id="formCaption">Create a secure checkout preview for your customer.</p></div><div class="segmented" role="tablist" aria-label="Payment action"><button class="segment active" id="payTab" type="button" role="tab" aria-selected="true" data-mode="pay">Accept</button><button class="segment" id="requestTab" type="button" role="tab" aria-selected="false" data-mode="request">Request</button></div></div>
					<form class="form-body" id="paymentForm" novalidate>
						<div class="field"><label class="field-label" for="amount">Amount</label><div class="input-wrap amount-wrap"><span class="currency-symbol" id="currencySymbol">$</span><input id="amount" name="amount" type="number" min="0.5" max="999999" step="0.01" placeholder="0.00" inputmode="decimal" required aria-describedby="amountHelp"><select id="currency" name="currency" aria-label="Currency"><option value="USD">USD</option><option value="EUR">EUR</option><option value="GBP">GBP</option><option value="CAD">CAD</option><option value="AUD">AUD</option></select></div><p class="helper" id="amountHelp">Enter an amount from 0.50 to 999,999.00.</p></div>
						<div class="field"><label class="field-label" for="customerEmail">Customer email <span class="optional" id="emailOptional">Optional</span></label><div class="input-wrap"><input id="customerEmail" name="customerEmail" type="email" autocomplete="email" placeholder="customer@example.com"></div></div>
						<div class="field"><label class="field-label" for="paymentNote">Description <span class="optional">Optional</span></label><div class="input-wrap"><input id="paymentNote" name="paymentNote" type="text" maxlength="72" placeholder="What is this payment for?"></div></div>
						<button class="primary-button" id="submitPayment" type="submit"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Continue to demo checkout</span></button>
						<p class="secure-note"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 10V7.5a5 5 0 0 1 10 0V10m-11 0h12v10H6z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>Payment details are never entered on this demo page.</p>
					</form>
				</section>

				<section class="panel preview-panel" aria-label="Secure checkout preview">
					<div class="preview-banner"><p class="preview-kicker">A clearer way to pay</p><h2>Simple checkout.<br>Peace of mind.</h2><p>Built for a smooth customer handoff.</p></div>
					<div class="checkout-card"><div class="checkout-top"><span class="checkout-merchant"><span class="mini-mark">E</span>EchoCash Studio</span><span>CHECKOUT PREVIEW</span></div><p class="checkout-amount" id="previewAmount">$0.00</p><p class="checkout-caption" id="previewDescription">Payment description</p><div class="checkout-method"><span class="method-left"><span class="card-chip" aria-hidden="true"></span>Payment method</span><span aria-hidden="true">••••</span></div><button class="checkout-continue" type="button" id="previewContinue">Continue securely</button><p class="secure-caption">In production, payment authentication happens with your provider.</p></div>
				</section>
			</div>

			<section class="panel activity-panel" id="activity" aria-labelledby="activityTitle">
				<div class="panel-head activity-head"><div><h2 class="panel-title" id="activityTitle">Recent activity</h2><p class="panel-caption">Demo transactions from this session.</p></div><button class="text-button" type="button" data-view="activity">View activity</button></div>
				<div class="activity-list" id="activityList"><div class="empty-state"><div><span class="empty-state-mark"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></span><p>Your demo payments will appear here.</p></div></div></div>
			</section>

			<section class="panel links-panel" id="requests" aria-labelledby="requestsTitle">
				<div class="panel-head activity-head"><div><h2 class="panel-title" id="requestsTitle">Payment requests</h2><p class="panel-caption">Create a link to share with a customer.</p></div><button class="text-button" type="button" data-mode="request">New request</button></div>
				<div class="links-list" id="linksList"><div class="empty-state"><div><span class="empty-state-mark"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M10 13.5 8.7 14.8a3.1 3.1 0 0 1-4.4-4.4l3.2-3.2a3.1 3.1 0 0 1 4.4 0m2.1 3.3 1.3-1.3a3.1 3.1 0 0 1 4.4 4.4l-3.2 3.2a3.1 3.1 0 0 1-4.4 0" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></span><p>Payment links you create will appear here.</p></div></div></div>
			</section>
			<p class="demo-footer">EchoCash demo workspace. This prototype does not process payments or store customer payment credentials. Use a payment provider's hosted checkout for live transactions.</p>
		</main>
	</div>

	<div class="modal-backdrop" id="checkoutModal" hidden>
		<section class="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle" aria-describedby="modalCopy">
			<div class="modal-top"><span class="modal-icon"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 10V7.5a5 5 0 0 1 10 0V10m-11 0h12v10H6z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></span><button class="modal-close" id="closeModal" type="button" aria-label="Close checkout">×</button></div>
			<h2 id="modalTitle">Secure checkout preview</h2><p class="modal-copy" id="modalCopy">In a live payment, EchoCash would hand you off to its payment provider to complete checkout.</p>
			<div class="order-summary"><span class="order-merchant"><span class="mini-mark">E</span><span id="modalDescription">EchoCash Studio</span></span><span class="order-total" id="modalAmount">$0.00</span></div>
			<div class="modal-disclaimer"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 8v5m0 3.5v.1M10 3.7 2.8 17a2 2 0 0 0 1.8 3h14.8a2 2 0 0 0 1.8-3L14 3.7a2.3 2.3 0 0 0-4 0Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Demo only. No money will move, and no PIN, card number, or banking credentials are requested or stored.</span></div>
			<button class="primary-button" id="completeDemo" type="button">Complete demo payment</button><button class="modal-secondary" id="cancelCheckout" type="button">Cancel</button>
		</section>
	</div>
	<div class="toast" id="toast" role="status" aria-live="polite"></div>

	<script>
		(() => {
			const symbols = { USD: '$', EUR: '€', GBP: '£', CAD: 'CA$', AUD: 'A$' };
			const state = { mode: 'pay', payments: [], requests: [] };
			const amountInput = document.getElementById('amount');
			const currencyInput = document.getElementById('currency');
			const customerEmail = document.getElementById('customerEmail');
			const paymentNote = document.getElementById('paymentNote');
			const modal = document.getElementById('checkoutModal');
			const toast = document.getElementById('toast');
			let toastTimer;

			function money(amount, currency) {
				return new Intl.NumberFormat(undefined, { style: 'currency', currency }).format(amount);
			}

			function currentAmount() {
				const amount = Number(amountInput.value);
				return Number.isFinite(amount) ? amount : 0;
			}

			function updatePreview() {
				const currency = currencyInput.value;
				const amount = currentAmount();
				document.getElementById('currencySymbol').textContent = symbols[currency] || '$';
				document.getElementById('previewAmount').textContent = money(amount, currency);
				document.getElementById('modalAmount').textContent = money(amount, currency);
				document.getElementById('previewDescription').textContent = paymentNote.value.trim() || 'Payment description';
				document.getElementById('modalDescription').textContent = paymentNote.value.trim() || 'EchoCash Studio';
			}

			function showToast(message) {
				toast.textContent = message;
				toast.classList.add('show');
				clearTimeout(toastTimer);
				toastTimer = setTimeout(() => toast.classList.remove('show'), 2800);
			}

			function setMode(mode) {
				state.mode = mode;
				const isRequest = mode === 'request';
				document.getElementById('payTab').classList.toggle('active', !isRequest);
				document.getElementById('requestTab').classList.toggle('active', isRequest);
				document.getElementById('payTab').setAttribute('aria-selected', String(!isRequest));
				document.getElementById('requestTab').setAttribute('aria-selected', String(isRequest));
				document.getElementById('collectTitle').textContent = isRequest ? 'Create a payment request' : 'Collect a payment';
				document.getElementById('formCaption').textContent = isRequest ? 'Create a shareable demo request link.' : 'Create a secure checkout preview for your customer.';
				document.getElementById('submitPayment').querySelector('span').textContent = isRequest ? 'Create demo request link' : 'Continue to demo checkout';
				document.getElementById('emailOptional').textContent = isRequest ? 'Optional' : 'Optional';
				document.getElementById('customerEmail').placeholder = isRequest ? 'payer@example.com' : 'customer@example.com';
				document.getElementById('breadcrumb').textContent = isRequest ? 'Payment requests' : (mode === 'pay' ? 'Collect payment' : 'Overview');
			}

			function addActivity(payment) {
				const list = document.getElementById('activityList');
				const empty = list.querySelector('.empty-state');
				if (empty) empty.remove();
				const row = document.createElement('article');
				row.className = 'activity-row';
				const icon = document.createElement('span');
				icon.className = 'activity-icon';
				icon.setAttribute('aria-hidden', 'true');
				icon.innerHTML = '<svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';
				const details = document.createElement('div');
				const description = document.createElement('div');
				description.className = 'activity-description';
				description.textContent = payment.description || payment.email || 'Demo checkout';
				const meta = document.createElement('div');
				meta.className = 'activity-meta';
				meta.textContent = new Intl.DateTimeFormat(undefined, { hour: 'numeric', minute: '2-digit' }).format(payment.date) + ' · Demo payment';
				details.append(description, meta);
				const value = document.createElement('div');
				const amount = document.createElement('div');
				amount.className = 'activity-amount';
				amount.textContent = money(payment.amount, payment.currency);
				const status = document.createElement('div');
				status.className = 'activity-status';
				status.textContent = 'Demo complete';
				value.append(amount, status);
				row.append(icon, details, value);
				list.prepend(row);
			}

			function updateSummary() {
				const total = state.payments.reduce((sum, payment) => sum + payment.amount, 0);
				const summaryCurrency = state.payments.length ? state.payments[state.payments.length - 1].currency : 'USD';
				document.getElementById('receivedTotal').textContent = money(total, summaryCurrency);
				document.getElementById('paymentCount').textContent = String(state.payments.length);
				document.getElementById('openRequestCount').textContent = String(state.requests.length);
				document.getElementById('requestCount').textContent = String(state.requests.length);
			}

			function createRequest() {
				const amount = currentAmount();
				if (amount < 0.5 || amount > 999999) {
					amountInput.setCustomValidity('Enter an amount between 0.50 and 999,999.00.');
					amountInput.reportValidity();
					amountInput.setCustomValidity('');
					return;
				}
				if (customerEmail.value && !customerEmail.validity.valid) {
					customerEmail.reportValidity();
					return;
				}
				const request = {
					amount,
					currency: currencyInput.value,
					email: customerEmail.value.trim(),
					description: paymentNote.value.trim() || 'Payment request',
					url: location.href.split('#')[0] + '#demo-request=' + encodeURIComponent(amount.toFixed(2) + '-' + currencyInput.value)
				};
				state.requests.unshift(request);
				renderRequests();
				updateSummary();
				showToast('Demo payment request created. Share the link with your customer.');
				document.getElementById('requests').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
			}

			function renderRequests() {
				const list = document.getElementById('linksList');
				list.replaceChildren();
				if (!state.requests.length) {
					const empty = document.createElement('div');
					empty.className = 'empty-state';
					const content = document.createElement('div');
					const mark = document.createElement('span');
					mark.className = 'empty-state-mark';
					mark.textContent = '↗';
					const text = document.createElement('p');
					text.textContent = 'Payment links you create will appear here.';
					content.append(mark, text);
					empty.append(content);
					list.append(empty);
					return;
				}
				state.requests.forEach((request) => {
					const row = document.createElement('div');
					row.className = 'link-row';
					const detail = document.createElement('div');
					const title = document.createElement('div');
					title.className = 'link-title';
					title.textContent = request.description + ' · ' + money(request.amount, request.currency);
					const link = document.createElement('div');
					link.className = 'link-url';
					link.textContent = request.email || request.url;
					detail.append(title, link);
					const copy = document.createElement('button');
					copy.className = 'copy-link';
					copy.type = 'button';
					copy.textContent = 'Copy link';
					copy.setAttribute('aria-label', 'Copy demo payment request link');
					copy.addEventListener('click', async () => {
						try {
							await navigator.clipboard.writeText(request.url);
							showToast('Demo request link copied.');
						} catch {
							showToast('Clipboard unavailable. Select and copy the page URL with its demo request value.');
						}
					});
					row.append(detail, copy);
					list.append(row);
				});
			}

			function openCheckout() {
				updatePreview();
				modal.hidden = false;
				document.getElementById('closeModal').focus();
			}

			function closeCheckout() {
				modal.hidden = true;
				document.getElementById('previewContinue').focus();
			}

			amountInput.addEventListener('input', updatePreview);
			paymentNote.addEventListener('input', updatePreview);
			currencyInput.addEventListener('change', updatePreview);
			document.getElementById('payTab').addEventListener('click', () => setMode('pay'));
			document.getElementById('requestTab').addEventListener('click', () => setMode('request'));
			document.querySelectorAll('[data-mode]').forEach((button) => button.addEventListener('click', () => {
				setMode(button.dataset.mode);
				document.getElementById('collect').scrollIntoView({ behavior: 'smooth', block: 'start' });
			}));
			document.querySelectorAll('.nav-link[data-view]').forEach((link) => link.addEventListener('click', () => {
				document.querySelectorAll('.nav-link').forEach((item) => item.classList.toggle('active', item === link));
				const view = link.dataset.view;
				if (view === 'collect') setMode('pay');
				if (view === 'requests') setMode('request');
				document.getElementById(view === 'overview' ? 'overview' : view === 'collect' ? 'collect' : view === 'requests' ? 'requests' : 'activity').scrollIntoView({ behavior: 'smooth', block: 'start' });
				document.getElementById('breadcrumb').textContent = link.textContent.trim();
			}));
			document.getElementById('paymentForm').addEventListener('submit', (event) => {
				event.preventDefault();
				if (state.mode === 'request') {
					createRequest();
					return;
				}
				const amount = currentAmount();
				if (amount < 0.5 || amount > 999999) {
					amountInput.setCustomValidity('Enter an amount between 0.50 and 999,999.00.');
					amountInput.reportValidity();
					amountInput.setCustomValidity('');
					return;
				}
				if (customerEmail.value && !customerEmail.validity.valid) {
					customerEmail.reportValidity();
					return;
				}
				openCheckout();
			});
			document.getElementById('previewContinue').addEventListener('click', () => {
				if (currentAmount() < 0.5 || currentAmount() > 999999) {
					amountInput.focus();
					showToast('Enter a valid amount to preview checkout.');
					return;
				}
				setMode('pay');
				openCheckout();
			});
			document.getElementById('completeDemo').addEventListener('click', () => {
				const payment = { amount: currentAmount(), currency: currencyInput.value, email: customerEmail.value.trim(), description: paymentNote.value.trim(), date: new Date() };
				state.payments.unshift(payment);
				addActivity(payment);
				updateSummary();
				closeCheckout();
				showToast('Demo complete. No real payment was processed.');
			});
			document.getElementById('closeModal').addEventListener('click', closeCheckout);
			document.getElementById('cancelCheckout').addEventListener('click', closeCheckout);
			modal.addEventListener('click', (event) => { if (event.target === modal) closeCheckout(); });
			document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && !modal.hidden) closeCheckout(); });
			document.getElementById('todayLabel').textContent = new Intl.DateTimeFormat(undefined, { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' }).format(new Date());
			updatePreview();
		})();
	</script>
</body>
</html>
